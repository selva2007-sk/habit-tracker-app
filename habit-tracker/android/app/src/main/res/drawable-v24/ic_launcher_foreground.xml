<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">

    <!-- Circular Ring with Gradient -->
    <path
        android:pathData="M54,24 A30,30 0 1,1 53.9,24"
        android:strokeWidth="3"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="24"
                android:startY="54"
                android:endX="84"
                android:endY="54"
                android:type="linear">
                <item android:offset="0" android:color="#00D2FF"/>
                <item android:offset="1" android:color="#9D50BB"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glow/Inner Circle (faint) -->
    <path
        android:pathData="M54,26 A28,28 0 1,1 53.9,26"
        android:strokeWidth="1"
        android:strokeAlpha="0.3"
        android:strokeColor="#FFFFFF" />

    <!-- Progress Bars -->
    <path
        android:fillColor="#40C4FF"
        android:pathData="M42,68 L46,68 L46,60 L42,60 Z" />
    <path
        android:fillColor="#40C4FF"
        android:pathData="M48,68 L52,68 L52,54 L48,54 Z" />
    <path
        android:fillColor="#40C4FF"
        android:pathData="M54,68 L58,68 L58,48 L54,48 Z" />
    <path
        android:fillColor="#40C4FF"
        android:pathData="M60,68 L64,68 L64,42 L60,42 Z" />

    <!-- Bold Checkmark -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M40,46 L52,58 L76,34" />

</vector>